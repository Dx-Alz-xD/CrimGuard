# Copy this file to .env to use your own PostgreSQL. Never commit .env.
# Without CRIMGUARD_DATABASE_URL, CrimGuard uses a SQLite copy at data/crimguard.db, seeded from
# database/crimguard.db the first time. Never point CRIMGUARD_SQLITE_PATH at the tracked seed itself.
CRIMGUARD_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/crimguard

# auto (default): PostgreSQL if reachable, otherwise SQLite. postgres: never fall back. sqlite: always SQLite.
# CRIMGUARD_DB=auto
# CRIMGUARD_SQLITE_PATH=data/crimguard.db
